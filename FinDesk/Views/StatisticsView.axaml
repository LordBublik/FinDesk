<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FinDesk.ViewModels"
             xmlns:models="using:FinDesk.Models"
             xmlns:converters="using:FinDesk.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="FinDesk.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

    <UserControl.Resources>
        <converters:PercentToWidthConverter x:Key="PercentToWidth"/>
        <converters:AmountToWidthConverter x:Key="AmountToWidth"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2196F3" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Grid ColumnDefinitions="*,*,*,*">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Всего доходов" FontSize="14" Foreground="White" Opacity="0.9"/>
                    <TextBlock Text="{Binding TotalIncome, StringFormat={}{0:N2} ₽}" 
                               FontSize="24" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Всего расходов" FontSize="14" Foreground="White" Opacity="0.9"/>
                    <TextBlock Text="{Binding TotalExpense, StringFormat={}{0:N2} ₽}" 
                               FontSize="24" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Баланс" FontSize="14" Foreground="White" Opacity="0.9"/>
                    <TextBlock Text="{Binding Balance, StringFormat={}{0:N2} ₽}" 
                               FontSize="24" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Транзакций" FontSize="14" Foreground="White" Opacity="0.9"/>
                    <TextBlock Text="{Binding TransactionCount}" 
                               FontSize="24" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="*,*">
            <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="20" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Расходы по категориям" 
                               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>
                    
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding CategoryStatistics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryStatistic">
                                    <Grid Margin="0,8" ColumnDefinitions="150, *, 80">
                                        <TextBlock Grid.Column="0" Text="{Binding CategoryName}" 
                                                   FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" Background="#E3F2FD" CornerRadius="4" Height="25" 
                                                VerticalAlignment="Center" Margin="10,0">
                                            <Border Background="#2196F3" CornerRadius="4" Height="25"
                                                    HorizontalAlignment="Left"
                                                    Width="{Binding Percentage, Converter={StaticResource PercentToWidth}, ConverterParameter=3}"/>
                                        </Border>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding Percentage, StringFormat={}{0:F1}%}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Доходы и расходы по дням" 
                               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>
                    
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding DailyStatistics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DailyStatistic">
                                    <Grid Margin="0,8" ColumnDefinitions="60, *, *">
                                        <TextBlock Grid.Column="0" Text="{Binding DateLabel}" 
                                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" 
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="4" Height="22" 
                                                Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Border Background="#4CAF50" CornerRadius="4" Height="22"
                                                    HorizontalAlignment="Left"
                                                    Width="{Binding Income, Converter={StaticResource AmountToWidth}, ConverterParameter=0.01}"/>
                                        </Border>

                                        <Border Grid.Column="2" Background="#FFEBEE" CornerRadius="4" Height="22" 
                                                Margin="5,0,0,0" VerticalAlignment="Center">
                                            <Border Background="#F44336" CornerRadius="4" Height="22"
                                                    HorizontalAlignment="Left"
                                                    Width="{Binding Expense, Converter={StaticResource AmountToWidth}, ConverterParameter=0.01}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>